{
  "name": "toktickit-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "End-to-end tests and screenshot capture for TokTickIT (Lab 2 and Lab 3).",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:lab2": "playwright test --project=lab-02",
    "e2e:lab3": "playwright test --project=lab-03",
    "e2e:ui": "playwright test --ui",
    "e2e:screenshots": "playwright test screenshots.spec.ts",
    "e2e:report": "playwright show-report artifacts/playwright-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
