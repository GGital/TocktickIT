generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Reused for Ticket.itPriority: one value set, one badge map, one sort order (spec §7.1).
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// Exactly one role per user, no role table and no history (BR-22).
enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

// The Lab 2 RequesterUser, renamed in place so every id and foreign key survives (BR-55, A-13).
model User {
  id                 Int      @id @default(autoincrement())
  fullName           String
  // Stored trimmed and lower-cased, so the plain unique index is case-insensitive (BR-49).
  email              String   @unique
  department         String?
  role               UserRole @default(REQUESTER)
  // scrypt$N$r$p$salt$hash (BR-09). Never selected into an API response (BR-12).
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets             Ticket[]        @relation("TicketRequester")
  assignedTickets     Ticket[]        @relation("TicketAssignee")
  uploadedAttachments Attachment[]    @relation("AttachmentUploadedBy")
  removedAttachments  Attachment[]    @relation("AttachmentRemovedBy")
  sessions            Session[]
  messages            TicketMessage[]
  performedActions    ActionTaken[]   @relation("ActionPerformedBy")
  editedActions       ActionTaken[]   @relation("ActionLastEditedBy")
  completedFollowUps  ActionTaken[]   @relation("ActionFollowUpCompletedBy")
  voidedActions       ActionTaken[]   @relation("ActionVoidedBy")

  @@index([role, isActive])
}

// Opaque server-side session: logout is a DELETE, not a denylist (A-02, BR-02).
model Session {
  id        String   @id
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Ticket {
  id                         Int               @id @default(autoincrement())
  ticketNumber               String            @unique
  requesterId                Int
  categoryId                 Int
  relatedSystemId            Int
  summary                    String            @db.VarChar(120)
  description                String            @db.Text
  requestedPriority          RequestedPriority
  // Initialised from requestedPriority; the only priority staff may change (BR-31, BR-32).
  itPriority                 RequestedPriority
  status                     TicketStatus      @default(NEW)
  // Null means unassigned (BR-26).
  assigneeId                 Int?
  // Null means not flagged by the Requester (BR-46).
  requesterResolvedFlaggedAt DateTime?
  // Optimistic concurrency: workflow writes and every Action Taken write bump it (BR-27 – BR-29).
  version                    Int               @default(1)
  // Set on every transition into RESOLVED, kept through CLOSED, cleared on REOPENED (BR-38).
  resolvedAt                 DateTime?
  // Last Requester-visible change only; Internal Notes never touch it (BR-45).
  publicActivityAt           DateTime          @default(now())
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  requester     User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee      User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem RelatedSystem   @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments   Attachment[]
  messages      TicketMessage[]
  actions       ActionTaken[]

  @@index([requesterId, createdAt])
  @@index([requesterId, categoryId])
  @@index([requesterId, relatedSystemId])
  @@index([requesterId, requestedPriority])
  @@index([status, itPriority, createdAt])
  @@index([assigneeId, status])
  @@index([requesterId, status])
  @@index([requesterId, publicActivityAt])
  @@index([resolvedAt])
  @@index([updatedAt])
  @@index([createdAt])
}

// A unit of work recorded against one Ticket; voided, never deleted (spec §7.1, BR-20, BR-21).
// The follow-up pairing, completion, and void all-or-nothing rules are CHECK constraints in the migration.
model ActionTaken {
  id                    Int       @id @default(autoincrement())
  ticketId              Int
  // Client-generated; a repeated create returns the original (BR-24).
  clientRequestId       String    @unique @db.Uuid
  actionAt              DateTime
  description           String    @db.Text
  result                String    @db.VarChar(1000)
  followUpRequired      Boolean
  // Non-null exactly when followUpRequired (BR-10).
  followUpNote          String?   @db.VarChar(1000)
  followUpCompletedAt   DateTime?
  followUpCompletedById Int?
  attachmentNotes       String?   @db.VarChar(500)
  // The authenticated user at creation; immutable (BR-03).
  performedById         Int
  lastEditedById        Int?
  // Null voidedAt means valid; voidedById and voidReason are set with it (BR-20).
  voidedAt              DateTime?
  voidedById            Int?
  voidReason            String?   @db.VarChar(500)
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ticket              Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  performedBy         User   @relation("ActionPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  lastEditedBy        User?  @relation("ActionLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  followUpCompletedBy User?  @relation("ActionFollowUpCompletedBy", fields: [followUpCompletedById], references: [id], onDelete: Restrict)
  voidedBy            User?  @relation("ActionVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([ticketId, actionAt, id])
  @@index([ticketId, voidedAt, followUpRequired, followUpCompletedAt])
  @@index([performedById, createdAt])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String    @unique
  mimeType         String
  sizeBytes        Int
  uploadedById     Int
  uploadedAt       DateTime  @default(now())
  // Null removedAt means active — one column encodes whether and when (spec §7.4).
  removedAt        DateTime?
  removalReason    String?
  removedById      Int?

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedBy  User?  @relation("AttachmentRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt])
}

// Public Comments and Internal Notes in one append-only table; visibility is always part
// of the read predicate, never a post-filter (A-05, BR-39, BR-40).
model TicketMessage {
  id         Int               @id @default(autoincrement())
  ticketId   Int
  authorId   Int
  visibility MessageVisibility
  body       String            @db.Text
  // True only for the Comment written by "Problem Appears Resolved" (BR-46).
  isSystem   Boolean           @default(false)
  createdAt  DateTime          @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, visibility, createdAt])
}

// One row per year; incremented atomically to issue TKT-YYYY-NNNNNN sequences (BR-03).
model TicketNumberCounter {
  year      Int @id
  lastValue Int
}
